{
  "name": "miko-desktop-companion",
  "version": "1.0.0",
  "description": "Cute anime-style desktop AI companion for Windows",
  "main": "dist-electron/main.js",
  "author": "Miko Team",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"VITE,ELECTRON\" -c \"cyan,magenta\" \"vite\" \"wait-on tcp:5173 && npm run electron:dev\"",
    "electron:dev": "npm run build:electron && cross-env NODE_ENV=development electron .",
    "build:renderer": "vite build",
    "build:electron": "esbuild electron/main.ts electron/preload.ts --outdir=dist-electron --bundle --platform=node --external:electron",
    "build": "npm run build:renderer && npm run build:electron",
    "preview": "vite preview",
    "dist": "npm run build && electron-builder --win",
    "dist:dir": "npm run build && electron-builder --win --dir",
    "dist:portable": "npm run build && electron-builder --win portable"
  },
  "dependencies": {
    "@types/three": "^0.186.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.miko.desktopcompanion",
    "productName": "Miko Companion",
    "directories": {
      "output": "release-build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "public/icons/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
